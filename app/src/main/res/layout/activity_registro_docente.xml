<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Fila del DNI con botones Buscar (lupa) y Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etDni"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="DNI"
                android:inputType="number" />

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍" />

            <Button
                android:id="@+id/btnEliminar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar" />
        </LinearLayout>

        <!-- Campos de texto para los datos del docente -->
        <EditText
            android:id="@+id/etApellidoPaterno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Apellido Paterno"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etApellidoMaterno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Apellido Materno"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:layout_marginBottom="8dp" />

        <!-- Spinner para Nivel Educativo -->
        <TextView
            android:id="@+id/lbl_niveleducativo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel Educativo" />

        <Spinner
            android:id="@+id/spNivelEducativo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:entries="@array/niveles_educativos" />

        <!-- Spinner para Cargo Laboral -->
        <TextView
            android:id="@+id/lbl_cargolaboral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargo Laboral" />

        <Spinner
            android:id="@+id/spCargoLaboral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:entries="@array/cargos_laborales" />

        <!-- Spinner para Situación Laboral -->
        <TextView
            android:id="@+id/lbl_situacionlaboral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Situación Laboral" />

        <Spinner
            android:id="@+id/spSituacionLaboral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:entries="@array/situaciones_laborales" />

        <!-- Campo numérico para Jornada Laboral -->
        <EditText
            android:id="@+id/etJornada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jornada Laboral"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <!-- Spinner para Sexo -->
        <TextView
            android:id="@+id/lbl_sexo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sexo" />

        <Spinner
            android:id="@+id/spSexo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:entries="@array/sexos" />

        <!-- Botón Guardar: Deshabilitado por defecto hasta llenar todos los campos -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:enabled="false" />
    </LinearLayout>
</ScrollView>